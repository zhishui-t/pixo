{
  "dcp": "resources\\dcp\\Nikon Z 5 2 RawLab LR Adobe Standard Baseline.dcp",
  "stages": [
    "exposure",
    "whitebalance",
    "huesat",
    "tone",
    "clarity",
    "colorcal",
    "skin",
    "stylize",
    "refine"
  ],
  "params": {
    "exposure": {
      "mode": "baseline",
      "vignette": 0.18
    },
    "whitebalance": {
      "mode": "as_shot"
    },
    "huesat": {
      "enabled": false
    },
    "tone": {
      "profile_curve": true,
      "eotf": "srgb",
      "brightness": 0.0
    },
    "colorcal": {
      "neutral_mode": "off",
      "saturation": -0.06,
      "skin_protect": 0.0
    },
    "refine": {
      "enabled": true,
      "highlight_desat": 0.25
    }
  }
}